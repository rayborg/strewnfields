---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  { href: `${base}explore/`, label: 'Explore' },
  { href: `${base}sources/`, label: 'Sources' },
  { href: `${base}methodology/`, label: 'Method' },
  { href: `${base}about/`, label: 'About' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={base} aria-label="Strewnfields home">
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span class="wordmark-copy">
        <strong>Strewnfields</strong>
        <small>Meteorite field atlas</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
