---
import type { Claim, Source } from '../data/schema';
import EvidenceBadge from './EvidenceBadge.astro';

interface Props {
  claim: Claim;
  sources: Source[];
  recordId: string;
}

const { claim, sources, recordId } = Astro.props;
---

<article class="claim-card" data-evidence={claim.evidence} id={claim.id}>
  <EvidenceBadge kind={claim.evidence} />
  <h3>{claim.label}</h3>
  <p>{claim.statement}</p>
  <p class="claim-meta">
    Assessment: {claim.confidence} confidence · editorially published
  </p>
  <details>
    <summary>Claim sources and note</summary>
    <ul>
      {
        claim.references.map((reference) => {
          const source = sources.find((item) => item.id === reference.sourceId);
          return (
            <li>
              <a
                href={`${import.meta.env.BASE_URL}sources/#${recordId}--${reference.sourceId}`}
              >
                {source?.authors ?? reference.sourceId}
                {source?.year ? ` (${source.year})` : ''}
              </a>
              : {reference.locator}
            </li>
          );
        })
      }
    </ul>
    {claim.editorialNote && <p class="fine-print">Editorial note: {claim.editorialNote}</p>}
  </details>
</article>
