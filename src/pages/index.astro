---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceLegend from '../components/EvidenceLegend.astro';
import StrewnfieldHero from '../components/StrewnfieldHero.astro';
import { catalogue } from '../data/catalogue';

const base = import.meta.env.BASE_URL;
const claimCount = catalogue.reduce((total, record) => total + record.claims.length, 0);
const coordinateCount = catalogue.reduce(
  (total, record) => total + record.coordinates.length,
  0,
);
---

<BaseLayout
  title="Strewnfields · Meteorite strewnfields mapped from the sources"
  description="Explore a provenance-first atlas of meteorite strewnfields, led by the documented 1912 Holbrook fall."
  imageAlt="Strewnfields, a sourced atlas of meteorite fall and recovery evidence"
>
  <div class="page-shell home-shell">
    <section class="landing-hero" aria-labelledby="home-title">
      <div class="landing-intro">
        <p class="eyebrow">Meteorite strewnfield atlas · Field ledger 01</p>
        <h1 id="home-title">Meteorite strewnfields, <em>mapped from the sources.</em></h1>
        <p class="lede">
          Follow observed falls and recovered stones without turning historical descriptions
          into false precision. Every field, point, and uncertainty keeps its evidence
          attached.
        </p>
        <div class="hero-actions">
          <a class="button" href={`${base}records/holbrook/`}>View the Holbrook record</a>
          <a class="text-link" href={`${base}explore/`}>Browse the atlas →</a>
        </div>
      </div>
      <StrewnfieldHero />
    </section>

    <section class="browse-section" aria-labelledby="browse-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Public catalogue · {catalogue.length} complete records</p>
          <h2 id="browse-heading">Browse documented fields</h2>
        </div>
        <a href={`${base}explore/`}>Search and filter all records →</a>
      </div>
      <div class="home-record-grid">
        {
          catalogue.map((record) => (
            <article class="home-record-card">
              <p class="record-index">Case {String(record.publicOrder).padStart(2, '0')}</p>
              <h3>
                <a href={`${base}records/${record.id}/`}>{record.name}</a>
              </h3>
              <p class="record-location">
                {record.locality} · {record.country}
              </p>
              <p>{record.summary}</p>
              <p class="record-meta">
                <span>{record.classification}</span>
                <span>{record.eventLabel}</span>
                <span>{record.sources.length} sources</span>
              </p>
              <a class="card-link" href={`${base}records/${record.id}/`}>
                Open record →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="method-section" aria-labelledby="principles-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How to read the atlas</p>
          <h2 id="principles-heading">Precision is a claim.</h2>
        </div>
        <p>
          A field is evidence, not decoration. Published coordinates, prose extents, and
          project interpretations are kept distinct.
        </p>
      </div>
      <div class="principles">
        <article class="principle">
          <span class="principle-index">01</span>
          <h3>Sources stay attached</h3>
          <p>Every published claim points to a source and a reviewable locator.</p>
        </article>
        <article class="principle">
          <span class="principle-index">02</span>
          <h3>Conflicts remain visible</h3>
          <p>Different coordinates, dates, or totals are preserved rather than averaged.</p>
        </article>
        <article class="principle">
          <span class="principle-index">03</span>
          <h3>Roles matter</h3>
          <p>A locality is not silently relabeled as an exact recovery or field center.</p>
        </article>
      </div>
      <EvidenceLegend />
    </section>

    <section class="stats-strip" aria-label="Public release scope">
      <div class="stat">
        <strong>{String(catalogue.length).padStart(2, '0')}</strong> public records
      </div>
      <div class="stat"><strong>{claimCount}</strong> atomic published claims</div>
      <div class="stat"><strong>{coordinateCount}</strong> public coordinate claims</div>
    </section>
  </div>
</BaseLayout>
